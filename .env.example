# Database
DATABASE_URL=mysql://root:password@localhost:3306/rightmove

# NordVPN SOCKS5 Credentials (OPTIONAL - leave blank to run without proxy)
# Get these from: https://my.nordaccount.com/dashboard/nordvpn/manual-configuration/
NORDVPN_USERNAME=
NORDVPN_PASSWORD=

# Browser Mode: 'headless' or 'headed'
BROWSER_MODE=headless

# Logging
LOG_LEVEL=info
